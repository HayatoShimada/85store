# Caddy に Cloudflare の DNS のモジュールを足す（証明書を DNS で取るため）。
# ビルドは手元の PC で行い、Go のクロスコンパイルで arm64 向けにする（エミュレーションより速い）
FROM --platform=$BUILDPLATFORM caddy:2-builder AS builder
ARG TARGETOS TARGETARCH
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH CGO_ENABLED=0 xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
