# cms.85-store.com の TLS を終端して Payload に渡す。
# tailscale serve が tailnet からの 443 番を PROXY プロトコル付きでここ（127.0.0.1:8443）に転送する。
# cms.85-store.com は CMS の端末の tailnet のアドレスを指すので、インターネットからは届かない。
{
	auto_https disable_redirects
	servers 127.0.0.1:8443 {
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.1/32
			}
			tls
		}
	}
}

cms.85-store.com:8443 {
	bind 127.0.0.1
	# 証明書は Let's Encrypt から DNS（Cloudflare）で取る（HTTP では外から確認できないため）
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
	# X-Forwarded-For は Caddy が接続元（tailnet のアドレス）で置き換える（外から送られた値は使わない）。
	# Payload はこれを tailscaled に問い合わせてログインさせる
	reverse_proxy 127.0.0.1:3000 {
		header_up -Tailscale-User-Login
		header_up -Tailscale-User-Name
		header_up -Tailscale-User-Profile-Pic
	}
}
