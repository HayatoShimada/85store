# 85-Store CMS（Payload）の環境変数。85pi では ~/85store-cms/.env に置く（Git に入れない）

# tailscale のサイドカー用の認証キー（タグ tag:cms、再利用しない・事前承認）
TS_AUTHKEY=

# Payload の暗号化キー（openssl rand -hex 32 で作る）
PAYLOAD_SECRET=
# SQLite のファイル（docker compose では /data/payload.db）
DATABASE_URL=file:./data/payload.db
# 管理画面の URL（tailnet 内）
CMS_SERVER_URL=https://cms.85-store.com
# メンバーが1人もいないとき、この Tailscale アカウントを管理者として自動登録する
CMS_BOOTSTRAP_ADMINS=info@85-store.com

# R2（画像と書き出した JSON）。未設定ならローカルの .local-bucket/ を使う
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=85store-media
# DB のバックアップ先（非公開のバケット）
LITESTREAM_BUCKET=85store-cms-backup
MEDIA_PUBLIC_URL=https://media.85-store.com

# 書き出したあとにサイトのキャッシュを作り直す
SITE_REVALIDATE_URL=https://85-store.com/api/revalidate
CMS_WEBHOOK_SECRET=

# ローカルでの開発だけ: Tailscale の代わりにこのメールでログインする
# CMS_DEV_LOGIN=info@85-store.com

# Shopify（Payload 専用のアプリ。Client Credentials）。商品・コレクション・ストアのページを書き出す
SHOPIFY_STORE=ctixqe-p0.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# 商品の同期。off（同期しない）/ dry-run（送る内容を記録するだけ。既定）/ live（送る）
SHOPIFY_SYNC_MODE=dry-run
# ストアのコレクション・ページ・ブログ・記事・メニューの同期（値は同じ）
SHOPIFY_STORE_SYNC_MODE=dry-run
# ローカルでの読み取りの確認だけ: アプリの代わりに固定のトークンを使う
# SHOPIFY_ADMIN_TOKEN=

# 85crm の内部 API（説明文の生成・納品書の読み取り・入荷の記録）。tailnet 内だけ
CRM_INTERNAL_URL=https://85pi.taila713c8.ts.net:11443
# 85crm の .env の INTERNAL_API_TOKEN と同じ値
CRM_INTERNAL_TOKEN=

# cms.85-store.com の証明書を Let's Encrypt から DNS で取るための Cloudflare の API トークン
# （権限は「ゾーン → DNS → 編集」、対象は 85-store.com だけ）
CLOUDFLARE_API_TOKEN=
